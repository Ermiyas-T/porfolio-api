# Required — PostgreSQL connection string (Neon or Railway managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/portfolio_db?sslmode=verify-full"

# JWT — must be at least 32 characters, generate with: openssl rand -hex 32
JWT_SECRET="change_this_to_a_random_32_char_minimum_secret"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="portfolio_admin_token"
AUTH_COOKIE_MAX_AGE_MS=604800000

# Frontend URL for CORS — no trailing slash
FRONTEND_URL="https://your-portfolio.vercel.app"

# Cloudinary — from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Server port (default 3001)
PORT=3001

# Seed script only — not used by the running server
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme_choose_a_strong_password"
