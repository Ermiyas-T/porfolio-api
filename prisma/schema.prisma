// Prisma schema for portfolio-api
// Prisma 7: datasource url moved to prisma.config.ts — schema only declares provider

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  // Markdown text only — never HTML; serialized from TipTap on the frontend
  content     String     @db.Text
  category    String
  tags        String[]
  featured    Boolean    @default(false)
  coverImage  String?
  status      PostStatus @default(DRAFT)
  // computed server-side on save, not a client-supplied value
  readingTime Int?
  publishedAt DateTime?
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model AdminUser {
  id       String @id @default(cuid())
  email    String @unique
  // bcrypt hash only — plaintext never stored or logged
  password String
}
